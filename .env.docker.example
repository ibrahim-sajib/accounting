# Docker environment for `docker compose up`.
#
# Copy to `.env.docker` and set APP_KEY (must match the host `.env` key):
#   php artisan key:generate --show   # then paste the value into APP_KEY below
#
# DB_* credentials are overridden by docker-compose.yml `environment`,
# so only caching/session/logging + boot behavior are configured here.
APP_NAME="Accounting ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# Auto-run migrations + seeders when the container boots (see docker/app/entrypoint.sh).
DB_MIGRATE=true
DB_SEED=true